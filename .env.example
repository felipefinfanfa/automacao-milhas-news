# PostgreSQL via Supabase (service role — bypassa RLS)
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# Email — Resend (primário)
RESEND_API_KEY=

# Gmail SMTP (fallback)
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Destinatário do digest
DIGEST_RECIPIENT=seuemail@gmail.com

# Não envia novo digest se o último foi há menos de N horas
DIGEST_MIN_INTERVAL_HOURS=12

# Cron schedules
DATA_SCAN_CRON=0 6,12,18 * * *
DIGEST_CRON=0 12 * * *

# Logs
LOG_LEVEL=info

# Ambiente
APP_ENV=production

# Sentry (opcional)
SENTRY_DSN=
